---
import BrandLogo from "@/components/ui/BrandLogo.astro";
import SiteHeader from "@/components/ui/SiteHeader.astro";

interface Props {
  class?: string;
  logoHref?: string;
}

const { class: className, logoHref } = Astro.props;
const { user } = Astro.locals;

const navLinkClass = "font-label text-muted-foreground hover:text-primary-container text-sm transition-colors";
---

<SiteHeader class:list={className} contentClass="max-w-7xl">
  {
    user ? (
      <>
        <div class="flex min-w-0 items-center gap-3">
          <BrandLogo href={logoHref} />
          <span class:list={[navLinkClass, "hidden truncate sm:inline"]}>{user.email}</span>
        </div>
        <nav class="flex items-center gap-4 md:gap-8" aria-label="App">
          <a href="/entries" class:list={navLinkClass}>
            Entries
          </a>
          <a
            href="/entries/new"
            class="bg-primary-container hover:bg-primary font-label hidden rounded px-4 py-2 text-sm text-white transition-colors md:inline-flex md:items-center"
          >
            New entry
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={[navLinkClass, "hover:underline"]}>
              Sign out
            </button>
          </form>
        </nav>
      </>
    ) : (
      <>
        <BrandLogo />
        <nav class="flex items-center gap-4 md:gap-8" aria-label="Account">
          <a href="/auth/signin" class:list={navLinkClass}>
            Sign in
          </a>
          <a
            href="/auth/signup"
            class="bg-primary-container hover:bg-primary font-label rounded px-4 py-2 text-sm text-white transition-colors"
          >
            Sign up
          </a>
        </nav>
      </>
    )
  }
</SiteHeader>
