---
import BrandLogo from "@/components/ui/BrandLogo.astro";

const { user } = Astro.locals;
---

<div
  class="border-border bg-muted mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm"
>
  {
    user ? (
      <>
        <div class="flex min-w-0 items-center gap-3">
          <BrandLogo href="/entries" />
          <span class="text-muted-foreground hidden truncate sm:inline">{user.email}</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/entries" class="text-secondary-foreground hover:text-primary transition-colors hover:underline">
            Entries
          </a>
          <a href="/entries/new" class="text-secondary-foreground hover:text-primary transition-colors hover:underline">
            New entry
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-muted-foreground hover:text-foreground transition-colors hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-secondary-foreground hover:text-primary transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-secondary-foreground hover:text-primary transition-colors hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
