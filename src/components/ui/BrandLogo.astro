---
interface Props {
  href?: string;
  small?: boolean;
  class?: string;
}

const { href = "/", class: className ,small} = Astro.props;
const height = small ? '' : 'md:h-8'
---

<a href={href} class:list={["inline-flex shrink-0 items-center", className]}>
  <img src="/logo-paint-ledger.svg" alt="Paint Ledger" class={`w-auto h-5 ${height}`} width="187" height="32" />
</a>
