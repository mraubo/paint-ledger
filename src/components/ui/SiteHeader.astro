---
interface Props {
  class?: string;
  contentClass?: string;
}

const { class: className, contentClass } = Astro.props;
---

<header class:list={["border-border bg-background sticky top-0 z-50 w-full border-b", className]}>
  <div class:list={["mx-auto flex w-full items-center justify-between gap-4 px-4 py-4 lg:px-16", contentClass]}>
    <slot />
  </div>
</header>
