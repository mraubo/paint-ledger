---
import MaterialSymbol from "@/components/landing/MaterialSymbol.astro";
---

<section
  id="features"
  class="bg-surface-container ink-border mx-auto my-10 max-w-7xl scroll-mt-20 rounded-xl px-4 py-10 md:px-16 md:py-16"
>
  <div class="mb-10 text-center md:mb-16">
    <h2 class="text-primary mb-2 text-3xl font-semibold">The Chronicler's Tools</h2>
    <p class="text-muted-foreground mx-auto max-w-2xl">
      Everything you need to document your hobby journey, designed with the careful structure of a hand-ruled ledger.
    </p>
  </div>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
    <div class="bg-background ink-border hover-lift flex h-full flex-col rounded-lg p-6">
      <div class="bg-primary-container mb-4 flex size-12 items-center justify-center rounded text-white">
        <MaterialSymbol name="menu_book" />
      </div>
      <h3 class="text-primary mb-2 text-xl font-semibold">The Digital Ledger</h3>
      <p class="text-muted-foreground flex-grow">
        Unify your models, palettes, and step-by-step processes in one place. Never forget which colors you used for a
        specific army scheme again.
      </p>
    </div>
    <div class="bg-background ink-border hover-lift flex h-full flex-col rounded-lg p-6">
      <div class="bg-primary-container mb-4 flex size-12 items-center justify-center rounded text-white">
        <MaterialSymbol name="inventory_2" />
      </div>
      <h3 class="text-primary mb-2 text-xl font-semibold">Recipe Management</h3>
      <p class="text-muted-foreground flex-grow">
        Manage your paints directly within your process. Track colors and mixes at every step of your painting workflow
        to ensure perfect consistency.
      </p>
    </div>
    <div class="bg-background ink-border hover-lift flex h-full flex-col rounded-lg p-6">
      <div class="bg-primary-container mb-4 flex size-12 items-center justify-center rounded text-white">
        <MaterialSymbol name="photo_library" />
      </div>
      <h3 class="text-primary mb-2 text-xl font-semibold">Visual Archiving</h3>
      <p class="text-muted-foreground flex-grow">
        Build a beautiful, high-quality photo gallery of your finished results. Look back at your early work and
        celebrate your progression as a painter.
      </p>
    </div>
  </div>
</section>
