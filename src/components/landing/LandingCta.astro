---
import MaterialSymbol from "@/components/landing/MaterialSymbol.astro";

interface Props {
  href: string;
  label: string;
  heading: string;
  description: string;
}

const { href, label, heading, description } = Astro.props;
---

<section id="cta" class="relative mx-auto my-10 max-w-4xl scroll-mt-20 px-4 py-10 text-center md:px-16 md:py-16">
  <div class="absolute inset-0 opacity-10" aria-hidden="true"></div>
  <div class="bg-background/95 ink-border relative z-10 rounded-lg p-8 backdrop-blur-sm md:p-10">
    <MaterialSymbol name="ink_pen" class="text-primary mx-auto mb-4 block text-4xl" />
    <h2 class="text-primary mb-4 text-3xl font-semibold">{heading}</h2>
    <p class="text-muted-foreground mx-auto mb-8 max-w-lg">{description}</p>
    <a
      href={href}
      class="bg-primary-container hover:bg-primary font-label inline-flex items-center gap-2 rounded px-8 py-3 text-sm text-white shadow-sm transition-colors"
    >
      {label}
      <MaterialSymbol name="arrow_forward" />
    </a>
  </div>
</section>
