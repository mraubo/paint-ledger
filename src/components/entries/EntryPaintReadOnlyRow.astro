---
import { isValidHexColor } from "@/lib/entry-paints-api";
import type { EntryPaintRow } from "@/lib/entry-paints-page";

interface Props {
  paint: EntryPaintRow;
}

const { paint } = Astro.props;
const metaParts = [paint.brand, paint.color_description].filter((part) => part.trim().length > 0);
const swatchColor = isValidHexColor(paint.approximate_color) ? paint.approximate_color : "#000000";
---

<li class="border-border bg-card h-full rounded-xl border p-4">
  <div class="flex items-center gap-4">
    <span
      class="border-border size-14 shrink-0 rounded-lg border"
      style={{ backgroundColor: swatchColor }}
      aria-hidden="true"></span>
    <div class="min-w-0 flex-1">
      <p class="text-foreground font-mono text-sm font-medium">{paint.name}</p>
      {metaParts.length > 0 && <p class="text-muted-foreground mt-0.5 text-sm">{metaParts.join(" · ")}</p>}
    </div>
  </div>
</li>
