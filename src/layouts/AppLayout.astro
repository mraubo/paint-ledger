---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";

interface Props {
  title?: string;
}

const { title = "Paint Ledger" } = Astro.props;
---

<Layout title={title}>
  <div class="bg-background text-foreground flex min-h-screen flex-col p-4 lg:px-16">
    <div class="mx-auto w-full max-w-4xl">
      <Topbar />
      <main class="mt-4">
        <slot />
      </main>
    </div>
  </div>
</Layout>
