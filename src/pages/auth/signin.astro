---
import Layout from "@/layouts/Layout.astro";
import PageCard from "@/components/ui/PageCard.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <PageCard class="w-full max-w-sm">
      <PageHeading title="Sign in" class="text-center" />
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary hover:underline">Sign up</a>
      </p>
    </PageCard>
  </div>
</Layout>
