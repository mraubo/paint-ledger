---
import AppLayout from "@/layouts/AppLayout.astro";
import Alert from "@/components/ui/Alert.astro";
import PageCard from "@/components/ui/PageCard.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import StatusChip from "@/components/ui/StatusChip.astro";
import EntryPaintReadOnlyRow from "@/components/entries/EntryPaintReadOnlyRow.astro";
import EntryStepReadOnly from "@/components/entries/EntryStepReadOnly.astro";
import { createClient } from "@/lib/supabase";
import { isValidEntryId } from "@/lib/entries-api";
import { loadEntryForEdit, resolveEntryFinalPhotoUrl, type EntryDetailBasics } from "@/lib/entries-page";
import { loadEntryPaints, type EntryPaintRow } from "@/lib/entry-paints-page";
import { loadEntrySteps, type EntryStepRow } from "@/lib/entry-steps-page";

const { id } = Astro.params;
const notFoundUrl = `/entries?error=${encodeURIComponent("Entry not found")}`;

let entry: EntryDetailBasics | null = null;
let finalPhotoUrl: string | null = null;
let paintRows: EntryPaintRow[] = [];
let stepRows: EntryStepRow[] = [];
let paintsError: string | null = null;
let stepsError: string | null = null;
let redirectUrl: string | null = null;

if (!id || !isValidEntryId(id)) {
  redirectUrl = notFoundUrl;
} else {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    redirectUrl = `/entries?error=${encodeURIComponent("Supabase is not configured")}`;
  } else {
    entry = await loadEntryForEdit(supabase, id);
    if (!entry) {
      redirectUrl = notFoundUrl;
    } else {
      const [resolvedFinalPhotoUrl, paintsResult, stepsResult] = await Promise.all([
        resolveEntryFinalPhotoUrl(supabase, entry.final_photo_path),
        loadEntryPaints(supabase, id),
        loadEntrySteps(supabase, id),
      ]);

      finalPhotoUrl = resolvedFinalPhotoUrl;

      if (!paintsResult.ok) {
        paintsError = paintsResult.error;
      } else {
        paintRows = paintsResult.paints;
      }

      if (!stepsResult.ok) {
        stepsError = stepsResult.error;
      } else {
        stepRows = stepsResult.steps;
      }
    }
  }
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl);
}

if (!entry) {
  return Astro.redirect(notFoundUrl);
}

const loaderError = paintsError ?? stepsError;
const hasDescription = entry.description.trim().length > 0;
const hasModelInfo = entry.model_info.trim().length > 0;
const hasModelOriginNote = entry.model_origin_note.trim().length > 0;
---

<AppLayout title={entry.title}>
  <PageCard>
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <PageHeading title={entry.title} class="mb-0" />
      {entry.status === "draft" && <StatusChip status="draft" />}
      {entry.status === "ready" && <StatusChip status="ready" />}
    </div>

    {loaderError && <Alert variant="error" message="Could not load entry details. Please try again." class="mb-4" />}

    {
      finalPhotoUrl && (
        <div class="mb-8">
          <img
            src={finalPhotoUrl}
            alt={`Final result for ${entry.title}`}
            class="border-border max-h-96 w-full rounded-xl border object-cover"
          />
        </div>
      )
    }

    {
      hasDescription && (
        <section class="mb-8">
          <h2 class="text-foreground mb-2 font-serif text-lg font-semibold">Description</h2>
          <p class="text-foreground whitespace-pre-wrap">{entry.description}</p>
        </section>
      )
    }

    {
      hasModelInfo && (
        <section class="mb-8">
          <h2 class="text-foreground mb-2 font-serif text-lg font-semibold">Model information</h2>
          <p class="text-foreground whitespace-pre-wrap">{entry.model_info}</p>
        </section>
      )
    }

    {
      hasModelOriginNote && (
        <section class="mb-8">
          <h2 class="text-foreground mb-2 font-serif text-lg font-semibold">Model origin</h2>
          <p class="text-foreground whitespace-pre-wrap">{entry.model_origin_note}</p>
        </section>
      )
    }

    {
      paintRows.length > 0 && (
        <section class="mb-8">
          <h2 class="text-foreground mb-4 font-serif text-lg font-semibold">Paint palette</h2>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {paintRows.map((paint) => (
              <EntryPaintReadOnlyRow paint={paint} />
            ))}
          </ul>
        </section>
      )
    }

    {
      stepRows.length > 0 && (
        <section class="mb-8">
          <h2 class="text-foreground mb-4 font-serif text-lg font-semibold">Tutorial steps</h2>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {stepRows.map((step) => (
              <EntryStepReadOnly step={step} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="border-border mt-8 border-t pt-8">
      <a
        href={`/entries/${entry.id}/edit`}
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium transition-colors"
      >
        Edit entry
      </a>
    </div>

    <p class="text-muted-foreground mt-6 text-center text-sm">
      <a href="/entries" class="text-primary hover:underline">Back to entries</a>
    </p>
  </PageCard>
</AppLayout>
