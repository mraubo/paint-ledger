---
import AppLayout from "@/layouts/AppLayout.astro";
import EntryPaintReadOnlyRow from "@/components/entries/EntryPaintReadOnlyRow.astro";
import EntryStepReadOnly from "@/components/entries/EntryStepReadOnly.astro";
import { createClient } from "@/lib/supabase";
import { isValidEntryId } from "@/lib/entries-api";
import { loadEntryForEdit, resolveEntryFinalPhotoUrl, type EntryDetailBasics } from "@/lib/entries-page";
import { loadEntryPaints, type EntryPaintRow } from "@/lib/entry-paints-page";
import { loadEntrySteps, type EntryStepRow } from "@/lib/entry-steps-page";

const { id } = Astro.params;
const notFoundUrl = `/entries?error=${encodeURIComponent("Entry not found")}`;

let entry: EntryDetailBasics | null = null;
let finalPhotoUrl: string | null = null;
let paintRows: EntryPaintRow[] = [];
let stepRows: EntryStepRow[] = [];
let paintsError: string | null = null;
let stepsError: string | null = null;
let redirectUrl: string | null = null;

if (!id || !isValidEntryId(id)) {
  redirectUrl = notFoundUrl;
} else {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    redirectUrl = `/entries?error=${encodeURIComponent("Supabase is not configured")}`;
  } else {
    entry = await loadEntryForEdit(supabase, id);
    if (!entry) {
      redirectUrl = notFoundUrl;
    } else {
      const [resolvedFinalPhotoUrl, paintsResult, stepsResult] = await Promise.all([
        resolveEntryFinalPhotoUrl(supabase, entry.final_photo_path),
        loadEntryPaints(supabase, id),
        loadEntrySteps(supabase, id),
      ]);

      finalPhotoUrl = resolvedFinalPhotoUrl;

      if (!paintsResult.ok) {
        paintsError = paintsResult.error;
      } else {
        paintRows = paintsResult.paints;
      }

      if (!stepsResult.ok) {
        stepsError = stepsResult.error;
      } else {
        stepRows = stepsResult.steps;
      }
    }
  }
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl);
}

if (!entry) {
  return Astro.redirect(notFoundUrl);
}

const loaderError = paintsError ?? stepsError;
const hasDescription = entry.description.trim().length > 0;
const hasModelInfo = entry.model_info.trim().length > 0;
const hasModelOriginNote = entry.model_origin_note.trim().length > 0;
---

<AppLayout title={entry.title}>
  <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {entry.title}
      </h1>
      {
        entry.status === "draft" && (
          <span class="rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-xs text-blue-100/70">
            Draft
          </span>
        )
      }
      {
        entry.status === "ready" && (
          <span class="rounded-full border border-green-500/30 bg-green-900/30 px-2.5 py-0.5 text-xs text-green-200/90">
            Ready
          </span>
        )
      }
    </div>

    {
      loaderError && (
        <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
          Could not load entry details. Please try again.
        </p>
      )
    }

    {
      finalPhotoUrl && (
        <div class="mb-8">
          <img
            src={finalPhotoUrl}
            alt={`Final result for ${entry.title}`}
            class="max-h-96 w-full rounded-xl border border-white/20 object-cover"
          />
        </div>
      )
    }

    {
      hasDescription && (
        <section class="mb-8">
          <h2 class="mb-2 text-lg font-semibold text-blue-100/90">Description</h2>
          <p class="whitespace-pre-wrap text-blue-100/80">{entry.description}</p>
        </section>
      )
    }

    {
      hasModelInfo && (
        <section class="mb-8">
          <h2 class="mb-2 text-lg font-semibold text-blue-100/90">Model information</h2>
          <p class="whitespace-pre-wrap text-blue-100/80">{entry.model_info}</p>
        </section>
      )
    }

    {
      hasModelOriginNote && (
        <section class="mb-8">
          <h2 class="mb-2 text-lg font-semibold text-blue-100/90">Model origin</h2>
          <p class="whitespace-pre-wrap text-blue-100/80">{entry.model_origin_note}</p>
        </section>
      )
    }

    {
      paintRows.length > 0 && (
        <section class="mb-8">
          <h2 class="mb-4 text-lg font-semibold text-blue-100/90">Paint palette</h2>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {paintRows.map((paint) => (
              <EntryPaintReadOnlyRow paint={paint} />
            ))}
          </ul>
        </section>
      )
    }

    {
      stepRows.length > 0 && (
        <section class="mb-8">
          <h2 class="mb-4 text-lg font-semibold text-blue-100/90">Tutorial steps</h2>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {stepRows.map((step) => (
              <EntryStepReadOnly step={step} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="mt-8 border-t border-white/10 pt-8">
      <a
        href={`/entries/${entry.id}/edit`}
        class="inline-flex items-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
      >
        Edit entry
      </a>
    </div>

    <p class="mt-6 text-center text-sm text-blue-100/60">
      <a href="/entries" class="text-purple-300 hover:underline">Back to entries</a>
    </p>
  </div>
</AppLayout>
