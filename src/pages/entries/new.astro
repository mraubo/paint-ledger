---
import AppLayout from "@/layouts/AppLayout.astro";
import EntryBasicsForm from "@/components/entries/EntryBasicsForm";

const error = Astro.url.searchParams.get("error");
---

<AppLayout title="New entry">
  <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
    <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
      New entry
    </h1>
    <EntryBasicsForm mode="create" serverError={error} client:load />
    <p class="mt-4 text-center text-sm text-blue-100/60">
      <a href="/entries" class="text-purple-300 hover:underline">Back to entries</a>
    </p>
  </div>
</AppLayout>
