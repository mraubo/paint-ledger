---
import AppLayout from "@/layouts/AppLayout.astro";
import Alert from "@/components/ui/Alert.astro";
import PageCard from "@/components/ui/PageCard.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import StatusChip from "@/components/ui/StatusChip.astro";
import EntryListActionsMenu from "@/components/entries/EntryListActionsMenu";
import { createClient } from "@/lib/supabase";
import { formatEntryDate, formatStepCount, loadEntryList } from "@/lib/entries-page";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const listResult = supabase ? await loadEntryList(supabase) : { ok: true as const, entries: [] };
const entries = listResult.ok ? listResult.entries : [];
const listError = listResult.ok ? null : listResult.error;

const error = Astro.url.searchParams.get("error");

const MAX_DELETED_TITLE_LENGTH = 200;
const deletedRaw = Astro.url.searchParams.get("deleted");
let deletedTitle: string | null = null;
if (deletedRaw) {
  const trimmed = deletedRaw.trim();
  if (trimmed) {
    deletedTitle =
      trimmed.length > MAX_DELETED_TITLE_LENGTH ? `${trimmed.slice(0, MAX_DELETED_TITLE_LENGTH)}…` : trimmed;
  }
}
const showDeletedBanner = Boolean(deletedTitle);
---

<AppLayout title="Entries">
  <PageCard>
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <PageHeading title="Entries" class="!mb-0" />
      <a
        href="/entries/new"
        class="bg-primary-container hover:bg-primary rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors"
      >
        Create entry
      </a>
    </div>

    {
      showDeletedBanner && deletedTitle && (
        <Alert variant="success" message={`"${deletedTitle}" deleted`} class="mb-4" />
      )
    }

    {error && <Alert variant="error" message={error} class="mb-4" />}

    {listError && <Alert variant="error" message="Could not load entries. Please try again." class="mb-4" />}

    {
      !supabase ? (
        <p class="text-muted-foreground text-sm">Supabase is not configured. Entries cannot be loaded.</p>
      ) : listError ? null : entries.length === 0 ? (
        <div class="border-border bg-muted rounded-xl border p-6 text-center">
          <p class="text-muted-foreground mb-4">No entries yet. Create your first paint log entry to get started.</p>
          <a
            href="/entries/new"
            class="bg-primary-container hover:bg-primary inline-block rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors"
          >
            Create entry
          </a>
        </div>
      ) : (
        <ul class="divide-border divide-y">
          {entries.map((entry) => (
            <li class="flex flex-wrap items-center gap-4 py-4 first:pt-0 last:pb-0">
              {entry.photo_url && (
                <img
                  src={entry.photo_url}
                  alt={entry.title}
                  class="border-border size-16 shrink-0 rounded-lg border object-cover"
                />
              )}
              <div class="min-w-0 flex-1">
                <a
                  href={`/entries/${entry.id}`}
                  class="text-foreground hover:text-primary font-medium transition-colors hover:underline"
                >
                  {entry.title}
                </a>
                <p class="text-muted-foreground mt-1 text-xs">Updated {formatEntryDate(entry.updated_at)}</p>
              </div>
              <div class="ml-auto flex shrink-0 flex-wrap items-center justify-end gap-2">
                <span class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs">
                  {formatStepCount(entry.step_count)}
                </span>
                {entry.status === "draft" && <StatusChip status="draft" />}
                {entry.status === "ready" && <StatusChip status="ready" />}
                <EntryListActionsMenu entryId={entry.id} client:load />
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </PageCard>
</AppLayout>
