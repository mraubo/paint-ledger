---
import AppLayout from "@/layouts/AppLayout.astro";
import Alert from "@/components/ui/Alert.astro";
import PageCard from "@/components/ui/PageCard.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import EntryStepForm from "@/components/entries/EntryStepForm";
import EntryWorkflowNav from "@/components/entries/EntryWorkflowNav.astro";
import { PaintCard } from "@/components/entries/PaintCard";
import { createClient } from "@/lib/supabase";
import { isValidEntryId } from "@/lib/entries-api";
import { isValidPaintId } from "@/lib/entry-paints-api";
import { isValidStepId } from "@/lib/entry-steps-api";
import { loadEntryPaints, type EntryPaintRow } from "@/lib/entry-paints-page";
import { loadEntrySteps, type EntryStepRow } from "@/lib/entry-steps-page";
import { loadEntryForEdit } from "@/lib/entries-page";

const { id } = Astro.params;
const notFoundUrl = `/entries?error=${encodeURIComponent("Entry not found")}`;

let redirectUrl: string | null = null;
let entryId = "";
let entryTitle = "Entry steps";
let stepRows: EntryStepRow[] = [];
let paintRows: EntryPaintRow[] = [];
let listError: string | null = null;

if (!id || !isValidEntryId(id)) {
  redirectUrl = notFoundUrl;
} else {
  entryId = id;
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    redirectUrl = `/entries?error=${encodeURIComponent("Supabase is not configured")}`;
  } else {
    const entry = await loadEntryForEdit(supabase, id);
    if (!entry) {
      redirectUrl = notFoundUrl;
    } else {
      entryTitle = `${entry.title} — Steps`;
      const stepsResult = await loadEntrySteps(supabase, id);
      if (!stepsResult.ok) {
        listError = stepsResult.error;
      } else {
        stepRows = stepsResult.steps;
      }

      const paintsResult = await loadEntryPaints(supabase, id);
      if (paintsResult.ok) {
        paintRows = paintsResult.paints;
      }
    }
  }
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl);
}

const stepsBaseUrl = `/entries/${entryId}/steps`;
const error = Astro.url.searchParams.get("error");
const showAddedBanner = Astro.url.searchParams.get("added") === "1";
const showUpdatedBanner = Astro.url.searchParams.get("updated") === "1";
const showDeletedBanner = Astro.url.searchParams.get("deleted") === "1";
const showMovedBanner = Astro.url.searchParams.get("moved") === "1";

const editParam = Astro.url.searchParams.get("edit");
const editingStepId =
  editParam && isValidStepId(editParam) && stepRows.some((step) => step.id === editParam) ? editParam : null;
const editingStep = editingStepId ? stepRows.find((step) => step.id === editingStepId) : undefined;
const editFormError = editingStepId ? error : null;
const addFormError = editingStepId ? null : error;
const isEditView = Boolean(editingStep && editingStepId);

const paintAddedParam = Astro.url.searchParams.get("paint_added");
const paintAddedId =
  paintAddedParam && isValidPaintId(paintAddedParam) && paintRows.some((paint) => paint.id === paintAddedParam)
    ? paintAddedParam
    : null;

const assignedPaintIds = editingStep ? editingStep.assigned_paints.map((paint) => paint.id) : [];
const pageTitle = isEditView && editingStep ? `Edit step ${editingStep.position}` : entryTitle;
---

<AppLayout title={pageTitle}>
  <PageCard>
    {
      isEditView && editingStep && editingStepId ? (
        <>
          <PageHeading title="Edit step" subtitle={`Step ${editingStep.position}`} />

          {showUpdatedBanner && <Alert variant="success" message="Step updated" class="mb-4" />}

          {paintAddedId && <Alert variant="success" message="Paint added and selected" class="mb-4" />}

          <EntryStepForm
            mode="edit"
            entryId={entryId}
            stepId={editingStepId}
            initialDescription={editingStep.description}
            entryPaints={paintRows}
            assignedPaintIds={assignedPaintIds}
            paintAddedId={paintAddedId}
            initialPhotoUrl={editingStep.photo_url}
            serverError={editFormError}
            inlinePaintError={editFormError}
            cancelHref={stepsBaseUrl}
            client:load
          />

          <EntryWorkflowNav entryId={entryId} current="steps-edit" />
        </>
      ) : (
        <>
          <PageHeading title="Tutorial steps" subtitle="Ordered steps with paint assignments for this entry." />

          {showAddedBanner && <Alert variant="success" message="Step added" class="mb-4" />}

          {showUpdatedBanner && <Alert variant="success" message="Step updated" class="mb-4" />}

          {showDeletedBanner && <Alert variant="success" message="Step deleted" class="mb-4" />}

          {showMovedBanner && <Alert variant="success" message="Step order updated" class="mb-4" />}

          {paintAddedId && <Alert variant="success" message="Paint added and selected" class="mb-4" />}

          {listError && <Alert variant="error" message="Could not load steps. Please try again." class="mb-4" />}

          {stepRows.length === 0 && !listError && (
            <div class="border-border bg-muted mb-6 rounded-xl border p-6 text-center">
              <p class="text-muted-foreground">No steps yet. Add the first step to this entry&apos;s tutorial.</p>
            </div>
          )}

          <div class="mb-8">
            <h2 class="text-foreground mb-4 font-serif text-lg font-semibold">Add step</h2>
            <EntryStepForm
              mode="add"
              entryId={entryId}
              entryPaints={paintRows}
              paintAddedId={paintAddedId}
              serverError={addFormError}
              inlinePaintError={addFormError}
              client:load
            />
          </div>

          {stepRows.length > 0 && (
            <div>
              <h2 class="text-foreground mb-4 font-serif text-lg font-semibold">Steps</h2>
              <ul class="space-y-3">
                {stepRows.map((step, index) => (
                  <li class="border-border bg-card rounded-lg border p-4">
                    <div class="flex flex-wrap items-start gap-4">
                      {step.photo_url && (
                        <img
                          src={step.photo_url}
                          alt={`Step ${step.position}`}
                          class="border-border size-16 shrink-0 rounded-lg border object-cover"
                        />
                      )}
                      <div class="min-w-0 flex-1">
                        <p class="font-label text-muted-foreground text-xs uppercase">Step {step.position}</p>
                        <p class="text-foreground mt-1 whitespace-pre-wrap">{step.description}</p>
                        {step.assigned_paints.length > 0 && (
                          <div class="mt-3 flex flex-wrap gap-2">
                            {step.assigned_paints.map((paint) => (
                              <PaintCard name={paint.name} approximate_color={paint.approximate_color} />
                            ))}
                          </div>
                        )}
                      </div>
                      <div class="flex shrink-0 flex-wrap gap-2">
                        <a
                          href={`${stepsBaseUrl}?edit=${step.id}`}
                          class="border-border text-foreground hover:bg-accent inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm transition-colors"
                        >
                          Edit
                        </a>
                        {index > 0 && (
                          <form method="POST" action={`/api/entries/${entryId}/steps/${step.id}/move`}>
                            <input type="hidden" name="direction" value="up" />
                            <button
                              type="submit"
                              class="border-border text-foreground hover:bg-accent inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm transition-colors"
                            >
                              Move up
                            </button>
                          </form>
                        )}
                        {index < stepRows.length - 1 && (
                          <form method="POST" action={`/api/entries/${entryId}/steps/${step.id}/move`}>
                            <input type="hidden" name="direction" value="down" />
                            <button
                              type="submit"
                              class="border-border text-foreground hover:bg-accent inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm transition-colors"
                            >
                              Move down
                            </button>
                          </form>
                        )}
                        <form
                          method="POST"
                          action={`/api/entries/${entryId}/steps/${step.id}/delete`}
                          onsubmit="return confirm('Delete this step?')"
                        >
                          <button
                            type="submit"
                            class="border-destructive/30 text-destructive hover:bg-destructive/10 inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm transition-colors"
                          >
                            Delete
                          </button>
                        </form>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <EntryWorkflowNav entryId={entryId} current="steps" />
        </>
      )
    }
  </PageCard>
</AppLayout>
