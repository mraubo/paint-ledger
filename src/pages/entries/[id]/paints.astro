---
import AppLayout from "@/layouts/AppLayout.astro";
import Alert from "@/components/ui/Alert.astro";
import PageCard from "@/components/ui/PageCard.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import EntryPaintForm from "@/components/entries/EntryPaintForm";
import { createClient } from "@/lib/supabase";
import { isValidEntryId } from "@/lib/entries-api";
import { isValidHexColor, isValidPaintId } from "@/lib/entry-paints-api";
import { loadEntryPaints, type EntryPaintRow } from "@/lib/entry-paints-page";
import { loadEntryForEdit } from "@/lib/entries-page";

const { id } = Astro.params;
const notFoundUrl = `/entries?error=${encodeURIComponent("Entry not found")}`;

let redirectUrl: string | null = null;
let entryId = "";
let entryTitle = "Entry paints";
let paintRows: EntryPaintRow[] = [];
let listError: string | null = null;

if (!id || !isValidEntryId(id)) {
  redirectUrl = notFoundUrl;
} else {
  entryId = id;
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    redirectUrl = `/entries?error=${encodeURIComponent("Supabase is not configured")}`;
  } else {
    const entry = await loadEntryForEdit(supabase, id);
    if (!entry) {
      redirectUrl = notFoundUrl;
    } else {
      entryTitle = `${entry.title} — Paints`;
      const paintsResult = await loadEntryPaints(supabase, id);
      if (!paintsResult.ok) {
        listError = paintsResult.error;
      } else {
        paintRows = paintsResult.paints;
      }
    }
  }
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl);
}

const paintsBaseUrl = `/entries/${entryId}/paints`;
const error = Astro.url.searchParams.get("error");
const showAddedBanner = Astro.url.searchParams.get("added") === "1";
const showUpdatedBanner = Astro.url.searchParams.get("updated") === "1";
const showDeletedBanner = Astro.url.searchParams.get("deleted") === "1";

const editParam = Astro.url.searchParams.get("edit");
const editingPaintId =
  editParam && isValidPaintId(editParam) && paintRows.some((paint) => paint.id === editParam) ? editParam : null;
const editingPaint = editingPaintId ? paintRows.find((paint) => paint.id === editingPaintId) : undefined;
const editFormError = editingPaintId ? error : null;
const addFormError = editingPaintId ? null : error;
const isEditView = Boolean(editingPaint && editingPaintId);
const pageTitle = isEditView && editingPaint ? `Edit ${editingPaint.name}` : entryTitle;
---

<AppLayout title={pageTitle}>
  <PageCard>
    {
      isEditView && editingPaint && editingPaintId ? (
        <>
          <PageHeading title="Edit paint" subtitle={editingPaint.name} />

          <EntryPaintForm
            mode="edit"
            entryId={entryId}
            paintId={editingPaintId}
            initialValues={{
              name: editingPaint.name,
              brand: editingPaint.brand,
              color_description: editingPaint.color_description,
              approximate_color: editingPaint.approximate_color,
            }}
            serverError={editFormError}
            cancelHref={paintsBaseUrl}
            client:load
          />

          <p class="text-muted-foreground mt-6 text-center text-sm">
            <a href={paintsBaseUrl} class="text-primary hover:underline">
              Back to paints
            </a>
            <span class="text-muted-foreground/50 mx-2">·</span>
            <a href={`/entries/${entryId}/edit`} class="text-primary hover:underline">
              Back to entry
            </a>
          </p>
        </>
      ) : (
        <>
          <PageHeading title="Paint palette" subtitle="Entry-level paints for this recipe." />

          {showAddedBanner && <Alert variant="success" message="Paint added" class="mb-4" />}

          {showUpdatedBanner && <Alert variant="success" message="Paint updated" class="mb-4" />}

          {showDeletedBanner && <Alert variant="success" message="Paint deleted" class="mb-4" />}

          {listError && <Alert variant="error" message="Could not load paints. Please try again." class="mb-4" />}

          {paintRows.length === 0 && !listError && (
            <div class="border-border bg-muted mb-6 rounded-xl border p-6 text-center">
              <p class="text-muted-foreground">No paints yet. Add the first color to this entry&apos;s palette.</p>
            </div>
          )}

          <div class="mb-8">
            <h2 class="text-foreground mb-4 font-serif text-lg font-semibold">Add paint</h2>
            <EntryPaintForm mode="add" entryId={entryId} serverError={addFormError} client:load />
          </div>

          {paintRows.length > 0 && (
            <div>
              <h2 class="text-foreground mb-4 font-serif text-lg font-semibold">Paints</h2>
              <ul class="space-y-3">
                {paintRows.map((paint) => {
                  const metaParts = [paint.brand, paint.color_description].filter((part) => part.trim().length > 0);
                  const swatchColor = isValidHexColor(paint.approximate_color) ? paint.approximate_color : "#000000";

                  return (
                    <li class="border-border bg-card rounded-lg border p-4">
                      <div class="flex flex-wrap items-start gap-4">
                        <span
                          class="border-border mt-0.5 size-10 shrink-0 rounded-full border"
                          style={{ backgroundColor: swatchColor }}
                          aria-hidden="true"
                        />
                        <div class="min-w-0 flex-1">
                          <p class="text-foreground font-mono text-sm font-medium">{paint.name}</p>
                          {metaParts.length > 0 && <p class="text-muted-foreground text-sm">{metaParts.join(" · ")}</p>}
                        </div>
                        <div class="flex shrink-0 gap-2">
                          <a
                            href={`${paintsBaseUrl}?edit=${paint.id}`}
                            class="border-border text-foreground hover:bg-accent inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm transition-colors"
                          >
                            Edit
                          </a>
                          <form
                            method="POST"
                            action={`/api/entries/${entryId}/paints/${paint.id}/delete`}
                            onsubmit="return confirm('Delete this paint?')"
                          >
                            <button
                              type="submit"
                              class="border-destructive/30 text-destructive hover:bg-destructive/10 inline-flex items-center gap-1 rounded-lg border px-3 py-1.5 text-sm transition-colors"
                            >
                              Delete
                            </button>
                          </form>
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <p class="text-muted-foreground mt-6 text-center text-sm">
            <a href={`/entries/${entryId}/steps`} class="text-primary hover:underline">
              Manage steps
            </a>
            <span class="text-muted-foreground/50 mx-2">·</span>
            <a href={`/entries/${entryId}/edit`} class="text-primary hover:underline">
              Back to entry
            </a>
          </p>
        </>
      )
    }
  </PageCard>
</AppLayout>
