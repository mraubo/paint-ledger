---
import AppLayout from "@/layouts/AppLayout.astro";
import Alert from "@/components/ui/Alert.astro";
import PageCard from "@/components/ui/PageCard.astro";
import PageHeading from "@/components/ui/PageHeading.astro";
import StatusChip from "@/components/ui/StatusChip.astro";
import EntryBasicsForm from "@/components/entries/EntryBasicsForm";
import EntryFinalPhotoForm from "@/components/entries/EntryFinalPhotoForm";
import EntryWorkflowNav from "@/components/entries/EntryWorkflowNav.astro";
import { createClient } from "@/lib/supabase";
import { isValidEntryId } from "@/lib/entries-api";
import { loadEntryForEdit, resolveEntryFinalPhotoUrl, type EntryBasicsRow } from "@/lib/entries-page";

const { id } = Astro.params;
const notFoundUrl = `/entries?error=${encodeURIComponent("Entry not found")}`;

let entry: EntryBasicsRow | null = null;
let finalPhotoUrl: string | null = null;
let redirectUrl: string | null = null;

if (!id || !isValidEntryId(id)) {
  redirectUrl = notFoundUrl;
} else {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    redirectUrl = `/entries?error=${encodeURIComponent("Supabase is not configured")}`;
  } else {
    entry = await loadEntryForEdit(supabase, id);
    if (!entry) {
      redirectUrl = notFoundUrl;
    } else {
      finalPhotoUrl = await resolveEntryFinalPhotoUrl(supabase, entry.final_photo_path);
    }
  }
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl);
}

if (!entry) {
  return Astro.redirect(notFoundUrl);
}

const error = Astro.url.searchParams.get("error");
const statusError = Astro.url.searchParams.get("status_error");
const showCreatedBanner = Astro.url.searchParams.get("created") === "1";
const showSavedBanner = Astro.url.searchParams.get("saved") === "1";
const showFinalPhotoSavedBanner = Astro.url.searchParams.get("final_photo_saved") === "1";
const statusChanged = Astro.url.searchParams.get("status_changed");
const showStatusChangedBanner = statusChanged === "ready" || statusChanged === "draft";
const showDraftFinalPhotoWarning = entry.status === "draft" && !entry.final_photo_path;
const canMarkReady = entry.status === "draft" && Boolean(entry.final_photo_path);

const initialValues = {
  title: entry.title,
  description: entry.description,
  model_info: entry.model_info,
  model_origin_note: entry.model_origin_note,
};
---

<AppLayout title={entry.title}>
  <PageCard>
    <div class="mb-6 flex flex-wrap items-baseline gap-3">
      <PageHeading title={entry.title} class="mb-0" />
      {entry.status === "draft" && <StatusChip status="draft" />}
      {entry.status === "ready" && <StatusChip status="ready" />}
    </div>

    {showCreatedBanner && <Alert variant="success" message="Entry created" class="mb-4" />}

    {showSavedBanner && <Alert variant="success" message="Changes saved" class="mb-4" />}

    {showFinalPhotoSavedBanner && <Alert variant="success" message="Final photo saved" class="mb-4" />}

    {
      showStatusChangedBanner && (
        <Alert
          variant="success"
          message={statusChanged === "ready" ? "Entry marked as ready" : "Entry reverted to draft"}
          class="mb-4"
        />
      )
    }

    <EntryBasicsForm mode="edit" entryId={entry.id} initialValues={initialValues} serverError={error} client:load />

    <section class="border-border mt-10 border-t pt-8">
      <h2 class="text-foreground mb-1 font-serif text-lg font-semibold">Final result</h2>
      <p class="text-muted-foreground mb-4 text-sm">Photo of the finished model for this entry.</p>

      {
        showDraftFinalPhotoWarning && (
          <Alert variant="warning" message="Add a final result photo before marking this entry ready." class="mb-4" />
        )
      }

      <EntryFinalPhotoForm entryId={entry.id} initialPhotoUrl={finalPhotoUrl} serverError={error} client:load />
    </section>

    <section class="border-border mt-10 border-t pt-8">
      <h2 class="text-foreground mb-1 font-serif text-lg font-semibold">Status</h2>
      <p class="text-muted-foreground mb-4 text-sm">
        {
          entry.status === "draft"
            ? "Mark this entry ready when the recipe and final photo are complete."
            : "Revert to draft to continue editing this entry."
        }
      </p>

      {statusError && <Alert variant="error" message={statusError} class="mb-4" />}

      {
        canMarkReady && (
          <form method="POST" action={`/api/entries/${entry.id}/status-change`}>
            <input type="hidden" name="status" value="ready" />
            <button
              type="submit"
              class="bg-primary-container hover:bg-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors"
            >
              Mark as ready
            </button>
          </form>
        )
      }

      {
        entry.status === "draft" && !entry.final_photo_path && (
          <button
            type="button"
            disabled
            class="border-border bg-muted text-muted-foreground inline-flex cursor-not-allowed items-center rounded-lg border px-4 py-2 text-sm font-medium"
          >
            Mark as ready
          </button>
        )
      }

      {
        entry.status === "ready" && (
          <form
            method="POST"
            action={`/api/entries/${entry.id}/status-change`}
            onsubmit="return confirm('Revert this entry to draft?')"
          >
            <input type="hidden" name="status" value="draft" />
            <button
              type="submit"
              class="border-border text-foreground hover:bg-accent inline-flex items-center rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
            >
              Revert to draft
            </button>
          </form>
        )
      }
    </section>

    <EntryWorkflowNav entryId={entry.id} current="edit" />

    <section class="border-border mt-10 border-t pt-8">
      <h2 class="text-destructive mb-1 font-serif text-lg font-semibold">Danger zone</h2>
      <p class="text-muted-foreground mb-4 text-sm">
        Permanently delete this entry and all of its paints, steps, and photos. This cannot be undone.
      </p>
      <form method="POST" action={`/api/entries/${entry.id}/delete`} onsubmit="return confirm('Delete this entry?')">
        <button
          type="submit"
          class="border-destructive/30 text-destructive hover:bg-destructive/10 inline-flex items-center rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
        >
          Delete entry
        </button>
      </form>
    </section>
  </PageCard>
</AppLayout>
