---
import AppLayout from "@/layouts/AppLayout.astro";
import EntryBasicsForm from "@/components/entries/EntryBasicsForm";
import EntryFinalPhotoForm from "@/components/entries/EntryFinalPhotoForm";
import { createClient } from "@/lib/supabase";
import { isValidEntryId } from "@/lib/entries-api";
import { loadEntryForEdit, resolveEntryFinalPhotoUrl, type EntryBasicsRow } from "@/lib/entries-page";

const { id } = Astro.params;
const notFoundUrl = `/entries?error=${encodeURIComponent("Entry not found")}`;

let entry: EntryBasicsRow | null = null;
let finalPhotoUrl: string | null = null;
let redirectUrl: string | null = null;

if (!id || !isValidEntryId(id)) {
  redirectUrl = notFoundUrl;
} else {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    redirectUrl = `/entries?error=${encodeURIComponent("Supabase is not configured")}`;
  } else {
    entry = await loadEntryForEdit(supabase, id);
    if (!entry) {
      redirectUrl = notFoundUrl;
    } else {
      finalPhotoUrl = await resolveEntryFinalPhotoUrl(supabase, entry.final_photo_path);
    }
  }
}

if (redirectUrl) {
  return Astro.redirect(redirectUrl);
}

if (!entry) {
  return Astro.redirect(notFoundUrl);
}

const error = Astro.url.searchParams.get("error");
const statusError = Astro.url.searchParams.get("status_error");
const showSavedBanner = Astro.url.searchParams.get("saved") === "1";
const showFinalPhotoSavedBanner = Astro.url.searchParams.get("final_photo_saved") === "1";
const statusChanged = Astro.url.searchParams.get("status_changed");
const showStatusChangedBanner = statusChanged === "ready" || statusChanged === "draft";
const showDraftFinalPhotoWarning = entry.status === "draft" && !entry.final_photo_path;
const canMarkReady = entry.status === "draft" && Boolean(entry.final_photo_path);

const initialValues = {
  title: entry.title,
  description: entry.description,
  model_info: entry.model_info,
  model_origin_note: entry.model_origin_note,
};
---

<AppLayout title={entry.title}>
  <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {entry.title}
      </h1>
      {
        entry.status === "draft" && (
          <span class="rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-xs text-blue-100/70">
            Draft
          </span>
        )
      }
      {
        entry.status === "ready" && (
          <span class="rounded-full border border-green-500/30 bg-green-900/30 px-2.5 py-0.5 text-xs text-green-200/90">
            Ready
          </span>
        )
      }
    </div>

    {
      showSavedBanner && (
        <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
          Changes saved
        </p>
      )
    }

    {
      showFinalPhotoSavedBanner && (
        <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
          Final photo saved
        </p>
      )
    }

    {
      showStatusChangedBanner && (
        <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
          {statusChanged === "ready" ? "Entry marked as ready" : "Entry reverted to draft"}
        </p>
      )
    }

    <EntryBasicsForm mode="edit" entryId={entry.id} initialValues={initialValues} serverError={error} client:load />

    <section class="mt-10 border-t border-white/10 pt-8">
      <h2 class="mb-1 text-lg font-semibold text-blue-100/90">Final result</h2>
      <p class="mb-4 text-sm text-blue-100/60">Photo of the finished model for this entry.</p>

      {
        showDraftFinalPhotoWarning && (
          <p class="mb-4 rounded-lg border border-amber-500/30 bg-amber-900/20 px-3 py-2 text-sm text-amber-200/90">
            Add a final result photo before marking this entry ready.
          </p>
        )
      }

      <EntryFinalPhotoForm entryId={entry.id} initialPhotoUrl={finalPhotoUrl} serverError={error} client:load />
    </section>

    <section class="mt-10 border-t border-white/10 pt-8">
      <h2 class="mb-1 text-lg font-semibold text-blue-100/90">Status</h2>
      <p class="mb-4 text-sm text-blue-100/60">
        {
          entry.status === "draft"
            ? "Mark this entry ready when the recipe and final photo are complete."
            : "Revert to draft to continue editing this entry."
        }
      </p>

      {
        statusError && (
          <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
            {statusError}
          </p>
        )
      }

      {
        canMarkReady && (
          <form method="POST" action={`/api/entries/${entry.id}/status-change`}>
            <input type="hidden" name="status" value="ready" />
            <button
              type="submit"
              class="inline-flex items-center rounded-lg border border-green-500/30 bg-green-900/20 px-4 py-2 text-sm font-medium text-green-200 transition-colors hover:bg-green-900/30"
            >
              Mark as ready
            </button>
          </form>
        )
      }

      {
        entry.status === "draft" && !entry.final_photo_path && (
          <button
            type="button"
            disabled
            class="inline-flex cursor-not-allowed items-center rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-blue-100/40"
          >
            Mark as ready
          </button>
        )
      }

      {
        entry.status === "ready" && (
          <form
            method="POST"
            action={`/api/entries/${entry.id}/status-change`}
            onsubmit="return confirm('Revert this entry to draft?')"
          >
            <input type="hidden" name="status" value="draft" />
            <button
              type="submit"
              class="inline-flex items-center rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-blue-100/80 transition-colors hover:bg-white/10"
            >
              Revert to draft
            </button>
          </form>
        )
      }
    </section>

    <p class="mt-4 text-center text-sm text-blue-100/60">
      <a href={`/entries/${entry.id}`} class="text-purple-300 hover:underline">View entry</a>
      <span class="mx-2 text-blue-100/30">·</span>
      <a href={`/entries/${entry.id}/paints`} class="text-purple-300 hover:underline">Manage paints</a>
      <span class="mx-2 text-blue-100/30">·</span>
      <a href={`/entries/${entry.id}/steps`} class="text-purple-300 hover:underline">Manage steps</a>
      <span class="mx-2 text-blue-100/30">·</span>
      <a href="/entries" class="text-purple-300 hover:underline">Back to entries</a>
    </p>
  </div>
</AppLayout>
