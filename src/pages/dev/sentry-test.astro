---
import Layout from "@/layouts/Layout.astro";
import SentryTestButton from "@/components/dev/SentryTestButton";

// Cloudflare local dev reads SENTRY_DEBUG from .dev.vars (workerd), not astro:env/client.
const debugEnabled = import.meta.env.DEV && process.env.SENTRY_DEBUG === "1";

if (import.meta.env.PROD || !debugEnabled) {
  return new Response("Not Found", { status: 404 });
}
---

<Layout title="Sentry test (dev only)">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-2 text-center text-xl font-bold">Sentry verify (dev only)</h1>
      <p class="mb-6 text-center text-sm text-blue-100/70">
        Requires <code class="text-purple-200">SENTRY_DEBUG=1</code> in `.dev.vars` and a configured DSN.
      </p>
      <SentryTestButton client:load />
    </div>
  </div>
</Layout>
