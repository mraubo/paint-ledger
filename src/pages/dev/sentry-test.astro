---
import Layout from "@/layouts/Layout.astro";
import PageCard from "@/components/ui/PageCard.astro";
import SentryTestButton from "@/components/dev/SentryTestButton";
---

<Layout title="Sentry test (dev only)">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <PageCard class="w-full max-w-md">
      <h1 class="text-foreground mb-2 text-center font-serif text-xl font-semibold">Sentry verify (dev only)</h1>
      <p class="text-muted-foreground mb-6 text-center text-sm">
        Requires <code class="text-foreground">SENTRY_DEBUG=1</code> and <code class="text-foreground">SENTRY_DSN</code> in
        both <code class="text-foreground">.env</code> (client SDK) and <code class="text-foreground">.dev.vars</code> (SSR
        guard).
      </p>
      <SentryTestButton client:load />
    </PageCard>
  </div>
</Layout>
